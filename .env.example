# MongoDB (required)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=AppName

# Authentication & Security
JWT_SECRET_KEY=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Observability (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
POSTHOG_API_KEY=phc_your_posthog_key
POSTHOG_HOST=https://us.posthog.com
ENVIRONMENT=development

# Storage
BHV_BUCKET_PATH=bucket
MAX_UPLOAD_SIZE_MB=100

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# GDPR & Privacy
DATA_RETENTION_DAYS=365
GDPR_CONTACT_EMAIL=privacy@example.com

# Python
PYTHON_VERSION=3.12

# =============================================================================
# BHIV Ecosystem Integration (Day 1B - TANTRA Wiring)
# =============================================================================
# Set these to connect to external ecosystem services.
# When unset, the platform falls back to local implementations.

# Platform Identity
PLATFORM_ID=ai_content_platform
PLATFORM_SCHEMA_VERSION=1.0.0

# BHIV Core - Runtime governance and routing
BHIV_CORE_URL=
BHIV_CORE_API_KEY=
BHIV_CORE_TIMEOUT=30

# Creator Core - Structured blueprint generation
CREATOR_CORE_URL=
CREATOR_CORE_API_KEY=
CREATOR_CORE_TIMEOUT=30

# Prompt Runner - Deterministic prompt execution
PROMPT_RUNNER_URL=
PROMPT_RUNNER_API_KEY=
PROMPT_RUNNER_TIMEOUT=60

# Bucket Service - Canonical artifact persistence
BUCKET_SERVICE_URL=
BUCKET_SERVICE_API_KEY=
BUCKET_SERVICE_TIMEOUT=30

# InsightFlow - Runtime telemetry and observability
INSIGHTFLOW_URL=
INSIGHTFLOW_API_KEY=
INSIGHTFLOW_TIMEOUT=10

# TANTRA Runtime - Registration and orchestration
TANTRA_URL=
TANTRA_TIMEOUT=15
